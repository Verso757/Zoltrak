<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Encabezado Corporativo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RutaControl Telematics"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kiosco de Conductor &amp; Telemetría 1Hz"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Tarjeta de Estado GPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● TRANSMITIENDO 1Hz A HOSTINGER"
                android:textColor="#10B981"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Dispositivo: Obteniendo..."
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- SECCIÓN DE HERRAMIENTAS DE RUTA DEL CHOFER (LIBRES) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HERRAMIENTAS DE RUTA"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Botón 1: Abrir App de Ventas -->
        <Button
            android:id="@+id/btnOpenSalesApp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🚀 Abrir App de Ventas"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Botón 2: Enlazar Impresora Bluetooth (Sin PIN) -->
        <Button
            android:id="@+id/btnBluetoothPrinter"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🖨️ Enlazar Impresora Bluetooth"
            android:backgroundTint="#334155"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Botón 3: Limpiar Caché de App de Ventas (Sin PIN) -->
        <Button
            android:id="@+id/btnClearSalesCache"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🧹 Limpiar Caché de App de Ventas"
            android:backgroundTint="#475569"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- SECCIÓN DE SUPERVISIÓN Y CONTROL (CON PIN) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTROL &amp; SUPERVISIÓN"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Botón 4: Pausar/Iniciar Servicio (Pide PIN) -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Pausar Telemetría (PIN)"
            android:backgroundTint="#1E293B"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <!-- Botón 5: Menú de Ajustes Supervisor / Wi-Fi (Pide PIN 2026) -->
        <Button
            android:id="@+id/btnExitPin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚙️ Menú Supervisor (PIN 2026)"
            android:backgroundTint="#0F172A"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
